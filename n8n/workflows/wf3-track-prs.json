{
  "name": "WF3 Track PRs",
  "nodes": [
    {
      "id": "a3000000-0000-4000-8000-000000000001",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "a3000000-0000-4000-8000-000000000002",
      "name": "List open issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://api.github.com/repos/AdamHoppe98/Factory/issues?state=open&per_page=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "credentials": {
        "githubApi": {
          "id": "CcLRRNf9ryjsAy1J",
          "name": "Github Factory"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "a3000000-0000-4000-8000-000000000003",
      "name": "List closed issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/AdamHoppe98/Factory/issues?state=closed&per_page=100&since={{ $now.minus({days: 2}).toISO() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "credentials": {
        "githubApi": {
          "id": "CcLRRNf9ryjsAy1J",
          "name": "Github Factory"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "a3000000-0000-4000-8000-000000000004",
      "name": "List open PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "https://api.github.com/repos/AdamHoppe98/Factory/pulls?state=open&per_page=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "credentials": {
        "githubApi": {
          "id": "CcLRRNf9ryjsAy1J",
          "name": "Github Factory"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "a3000000-0000-4000-8000-000000000005",
      "name": "Find moves",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "executeOnce": true,
      "parameters": {
        "jsCode": "// Joins open issues, recently closed issues and open PRs by issue number,\n// and lists the state moves to make.\nconst STATES = ['Ideas', 'Refining', 'Ready for approval', 'Approved', 'Building',\n  'Waiting for you', 'Stuck', 'Your QA', 'Done'];\nconst ADAM = 'AdamHoppe98';\nconst state = i => i.labels.map(l => l.name).find(n => STATES.includes(n)) ?? null;\nconst issues = node => $(node).all().map(x => x.json)\n  .filter(i => i.number && !i.pull_request && i.user?.login === ADAM);\n\nconst moves = [];\n\n// A closed issue (merged PR with \"Closes #N\", or closed by Adam) is Done.\nfor (const i of issues('List closed issues')) {\n  const s = state(i);\n  if (s && s !== 'Done') moves.push({ number: i.number, from: s, to: 'Done', prUpdatedAt: '' });\n}\n\n// An open PR from branch issue-N moves a Building issue to Your QA.\n// Only Building: when Adam sends a task back to Approved, the PR stays open.\nconst open = issues('List open issues');\nfor (const pr of $('List open PRs').all().map(x => x.json)) {\n  const m = /^issue-(\\d+)$/.exec(pr.head?.ref ?? '');\n  const issue = m && open.find(i => i.number === Number(m[1]));\n  // Only PRs from branches in this repo count, not PRs from forks.\n  if (issue && state(issue) === 'Building' && pr.head?.repo?.full_name === 'AdamHoppe98/Factory') {\n    moves.push({ number: issue.number, from: 'Building', to: 'Your QA', prUpdatedAt: pr.updated_at });\n  }\n}\n\nreturn moves.map(json => ({ json }));"
      },
      "notes": "Why Code: joins three GitHub lists by issue number and applies the state rules. Native nodes would need several Merge, Filter and Set nodes."
    },
    {
      "id": "a3000000-0000-4000-8000-000000000006",
      "name": "Needs PR check?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "p1",
              "leftValue": "={{ $json.to }}",
              "rightValue": "Your QA",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a3000000-0000-4000-8000-000000000007",
      "name": "Get comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -140
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/AdamHoppe98/Factory/issues/{{ $json.number }}/comments?per_page=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "githubApi": {
          "id": "CcLRRNf9ryjsAy1J",
          "name": "Github Factory"
        }
      }
    },
    {
      "id": "a3000000-0000-4000-8000-000000000008",
      "name": "PR newer than build start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -140
      ],
      "parameters": {
        "jsCode": "// Keeps a Building -> Your QA move only if the PR changed after the latest\n// WF2 \"Building\" comment. An old PR from an earlier round doesn't count.\nconst moves = $('Needs PR check?').all();\nreturn $input.all().flatMap((item, i) => {\n  const move = moves[i].json;\n  const starts = (item.json.body ?? [])\n    .filter(c => c.user?.login === 'AdamHoppe98' && (c.body ?? '').startsWith('<!-- factory:status -->') && c.body.includes('**Building.**'))\n    .map(c => c.created_at);\n  const started = starts.length ? starts[starts.length - 1] : '';\n  // pairedItem keeps the link to the move, so later nodes can read it.\n  return move.prUpdatedAt > started ? [{ json: move, pairedItem: { item: i } }] : [];\n});"
      },
      "notes": "Why Code: compares each PR's update time with the latest Building comment of its issue."
    },
    {
      "id": "a3000000-0000-4000-8000-000000000009",
      "name": "Remove old state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "method": "DELETE",
        "url": "=https://api.github.com/repos/AdamHoppe98/Factory/issues/{{ $json.number }}/labels/{{ encodeURIComponent($json.from) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "githubApi": {
          "id": "CcLRRNf9ryjsAy1J",
          "name": "Github Factory"
        }
      },
      "notes": "Guarded move, same as WF1/WF2. 404 = Adam changed the state meanwhile."
    },
    {
      "id": "a3000000-0000-4000-8000-00000000000a",
      "name": "Still old state?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ $json.statusCode === 200 && !$json.body.some(l => ['Ideas', 'Refining', 'Ready for approval', 'Approved', 'Building', 'Waiting for you', 'Stuck', 'Your QA', 'Done'].includes(l.name)) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "200 = the old state label was there. If Adam set another state meanwhile, his label wins."
    },
    {
      "id": "a3000000-0000-4000-8000-00000000000b",
      "name": "Add new state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/AdamHoppe98/Factory/issues/{{ $('Find moves').item.json.number }}/labels",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ labels: [$('Find moves').item.json.to] }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "githubApi": {
          "id": "CcLRRNf9ryjsAy1J",
          "name": "Github Factory"
        }
      }
    }
  ],
  "connections": {
